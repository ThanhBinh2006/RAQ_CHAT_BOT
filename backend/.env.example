# =============================================================
# RAQ Chatbot — Environment Variables
# Copy this file to .env and fill in your values
# =============================================================

# ── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/raq_chatbot

# ── MinIO S3 Storage ─────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=pdf-storage
MINIO_USE_SSL=false

# ── JWT Authentication ───────────────────────────────────────
JWT_SECRET_KEY=your_super_secret_jwt_key_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

SYSTEM_NVIDIA_API_KEY=nvapi-...
SYSTEM_NVIDIA_EMBEDDING_KEY=nvapi-...
SYSTEM_GEMINI_API_KEY=AIzaSy...
SYSTEM_GROQ_API_KEY=gsk_...

# ── Default Models ───────────────────────────────────────────
DEFAULT_CHAT_MODEL=deepseek-ai/deepseek-v4-pro-0813
DEFAULT_EMBEDDING_MODEL=nvidia/nemotron-3-embed-1b

# ── Mock Mode ────────────────────────────────────────────────
# Set to "true" to use mock LLM responses (no real API calls)
# Set to "false" to use real API keys
USE_MOCK_LLM=true

# ── CORS ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
