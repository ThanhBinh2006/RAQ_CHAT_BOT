# ==============================================================================
# BIẾN MÔI TRƯỜNG DÀNH CHO SERVER CHẠY POSTGRESQL & MINIO
# Đổi tên file này thành .env hoặc truyền trực tiếp vào server
# ==============================================================================

# ── Cấu hình PostgreSQL (pgvector) ──────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_strong_postgres_password_change_me
POSTGRES_DB=raq_chatbot
POSTGRES_PORT=5432

# ── Cấu hình MinIO S3 ───────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=your_strong_minio_password_change_me
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
